{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_coverings": {
            "type": "panel",
            "label": "shutters",
            "items": {
                "shuttersHint": { "type": "staticText", "text": "shuttersHintText", "newLine": true },
                "scanForShutters": {
                    "type": "sendTo",
                    "command": "scanForShutters",
                    "jsonData": "{}",
                    "label": "scanButtonLabel",
                    "showProcess": true,
                    "newLine": true
                },
                "scanHint": { "type": "staticText", "text": "scanHintText", "newLine": true },
                "shutters": {
                    "type": "table",
                    "label": "shutters",
                    "newLine": true,
                    "useCardFor": ["xs", "sm", "md"],
                    "titleAttribute": "name",
                    "items": [
                        { "type": "text", "attr": "id", "title": "id", "width": "10%" },
                        { "type": "text", "attr": "name", "title": "coveringName", "width": "15%" },
                        { "type": "select", "attr": "coveringType", "title": "coveringType", "width": "12%", "default": "rolladen", "options": [{ "label": "coveringTypeRolladen", "value": "rolladen" }, { "label": "coveringTypeRaffstore", "value": "raffstore" }, { "label": "coveringTypeMarkise", "value": "markise" }, { "label": "coveringTypeLamellen", "value": "lamellen" }] },
                        { "type": "select", "attr": "driverType", "title": "driverType", "width": "15%", "default": "generic-position", "options": [{ "label": "driverTypeHomematic", "value": "homematic" }, { "label": "driverTypeHmip", "value": "hmip" }, { "label": "driverTypeKnx", "value": "knx" }, { "label": "driverTypeShelly", "value": "shelly" }, { "label": "driverTypeZigbee", "value": "zigbee" }, { "label": "driverTypeZigbee2Mqtt", "value": "zigbee2mqtt" }, { "label": "driverTypeTuya", "value": "tuya" }, { "label": "driverTypeSomfy", "value": "somfy" }, { "label": "driverTypeVelux", "value": "velux" }, { "label": "driverTypeEnocean", "value": "enocean" }, { "label": "driverTypeVelbus", "value": "velbus" }, { "label": "driverTypeLoxone", "value": "loxone" }, { "label": "driverTypeHomey", "value": "homey" }, { "label": "driverTypeMqtt", "value": "mqtt" }, { "label": "driverTypeGenericPosition", "value": "generic-position" }, { "label": "driverTypeGenericRelay", "value": "generic-relay" }] },
                        { "type": "select", "attr": "areaId", "title": "schedulePlan", "width": "12%", "options": "(data.areas || []).map(area => ({ value: area.id, label: area.name || area.id }))" },
                        { "type": "number", "attr": "orientation", "title": "orientation", "width": "10%", "min": 0, "max": 359 },
                        { "type": "checkbox", "attr": "automationEnabled", "title": "automationEnabled", "default": true },
                        { "type": "objectId", "attr": "states.position", "title": "statePosition", "width": "18%", "hidden": "data.driverType === 'generic-relay' || data.driverType === 'loxone'" },
                        { "type": "objectId", "attr": "states.positionActual", "title": "statePositionActual", "width": "18%", "hidden": "data.driverType === 'generic-relay'" },
                        { "type": "objectId", "attr": "states.control", "title": "stateControl", "width": "18%", "hidden": "data.driverType !== 'tuya'" },
                        { "type": "objectId", "attr": "states.open", "title": "stateOpen", "width": "18%", "hidden": "data.driverType !== 'generic-relay'" },
                        { "type": "objectId", "attr": "states.close", "title": "stateClose", "width": "18%", "hidden": "data.driverType !== 'generic-relay'" },
                        { "type": "objectId", "attr": "states.up", "title": "stateUp", "width": "18%", "hidden": "data.driverType !== 'loxone'" },
                        { "type": "objectId", "attr": "states.down", "title": "stateDown", "width": "18%", "hidden": "data.driverType !== 'loxone'" },
                        { "type": "objectId", "attr": "states.stop", "title": "stateStop", "width": "18%", "hidden": "data.driverType === 'generic-position' || data.driverType === 'mqtt' || data.driverType === 'tuya' || data.driverType === 'loxone' || data.driverType === 'generic-relay'" },
                        { "type": "objectId", "attr": "states.tilt", "title": "stateTilt", "width": "18%", "hidden": "data.coveringType !== 'raffstore' && data.coveringType !== 'lamellen'" },
                        { "type": "objectId", "attr": "states.tiltActual", "title": "stateTiltActual", "width": "18%", "hidden": "data.coveringType !== 'raffstore' && data.coveringType !== 'lamellen'" },
                        { "type": "checkbox", "attr": "invertPosition", "title": "invertPosition" },
                        { "type": "checkbox", "attr": "homematicLevelNormalized", "title": "homematicLevelNormalized", "hidden": "data.driverType !== 'homematic'" },
                        { "type": "number", "attr": "relayOpenRuntimeSecs", "title": "relayOpenRuntimeSecs", "min": 1, "hidden": "data.driverType !== 'generic-relay'" },
                        { "type": "number", "attr": "relayCloseRuntimeSecs", "title": "relayCloseRuntimeSecs", "min": 1, "hidden": "data.driverType !== 'generic-relay'" },
                        { "type": "checkbox", "attr": "sunProtectionEnabled", "title": "sunProtectionEnabled", "default": true },
                        { "type": "number", "attr": "sunTargetPercent", "title": "sunTargetPercent", "min": 0, "max": 100, "hidden": "!data.sunProtectionEnabled" },
                        { "type": "number", "attr": "sunProtectionMinTemp", "title": "sunProtectionMinTemp", "hidden": "!data.sunProtectionEnabled" },
                        { "type": "number", "attr": "orientationToleranceMinusDeg", "title": "orientationToleranceMinusDeg", "hidden": "!data.sunProtectionEnabled || data.orientation === undefined || data.orientation === null" },
                        { "type": "number", "attr": "orientationTolerancePlusDeg", "title": "orientationTolerancePlusDeg", "hidden": "!data.sunProtectionEnabled || data.orientation === undefined || data.orientation === null" },
                        { "type": "number", "attr": "sunProtectionMinElevationDeg", "title": "sunProtectionMinElevationDeg", "hidden": "!data.sunProtectionEnabled || data.orientation === undefined || data.orientation === null" },
                        { "type": "number", "attr": "sunProtectionMaxCloudCoverPercent", "title": "sunProtectionMaxCloudCoverPercent", "min": 0, "max": 100, "hidden": "!data.sunProtectionEnabled || data.orientation === undefined || data.orientation === null" },
                        { "type": "text", "attr": "sunWindowStart", "title": "sunWindowStart", "hidden": "!data.sunProtectionEnabled || (data.orientation !== undefined && data.orientation !== null)" },
                        { "type": "text", "attr": "sunWindowEnd", "title": "sunWindowEnd", "hidden": "!data.sunProtectionEnabled || (data.orientation !== undefined && data.orientation !== null)" },
                        { "type": "checkbox", "attr": "rainProtectionEnabled", "title": "rainProtectionEnabled" },
                        { "type": "number", "attr": "rainTargetPercent", "title": "rainTargetPercent", "min": 0, "max": 100, "hidden": "!data.rainProtectionEnabled" },
                        { "type": "number", "attr": "rainProtectionWindDirectionToleranceDeg", "title": "rainProtectionWindDirectionToleranceDeg", "min": 0, "max": 180, "hidden": "!data.rainProtectionEnabled || data.orientation === undefined || data.orientation === null" },
                        { "type": "checkbox", "attr": "windProtectionEnabled", "title": "windProtectionEnabled" },
                        { "type": "number", "attr": "windOpenThreshold", "title": "windOpenThreshold", "min": 0, "hidden": "!data.windProtectionEnabled" },
                        { "type": "number", "attr": "windCloseAllowedThreshold", "title": "windCloseAllowedThreshold", "min": 0, "hidden": "!data.windProtectionEnabled" },
                        { "type": "checkbox", "attr": "frostProtectionEnabled", "title": "frostProtectionEnabled" },
                        { "type": "checkbox", "attr": "nightCoolingEnabled", "title": "nightCoolingEnabled" },
                        { "type": "objectId", "attr": "nightCoolingIndoorTempStateId", "title": "nightCoolingIndoorTempStateId", "hidden": "!data.nightCoolingEnabled" },
                        { "type": "checkbox", "attr": "doorProtectionEnabled", "title": "doorProtectionEnabled", "default": true },
                        { "type": "objectId", "attr": "doorContactStateId", "title": "doorContactStateId", "filter": { "type": "state", "common": { "type": "boolean" } }, "hidden": "!data.doorProtectionEnabled" },
                        { "type": "checkbox", "attr": "invertDoorContact", "title": "invertDoorContact", "hidden": "!data.doorProtectionEnabled || !data.doorContactStateId" },
                        { "type": "number", "attr": "maxRuntimeSecs", "title": "maxRuntimeSecs", "min": 1 },
                        { "type": "number", "attr": "minCommandIntervalMs", "title": "minCommandIntervalMs", "min": 0 }
                    ]
                }
            }
        },
        "_schedules": {
            "type": "panel",
            "label": "areas",
            "items": {
                "areasHint": { "type": "staticText", "text": "areasHintText", "newLine": true },
                "holidayStateId": { "type": "objectId", "label": "holidayStateId", "filter": { "type": "state", "common": { "type": "boolean" } }, "newLine": true },
                "holidayHint": { "type": "staticText", "text": "holidayHintText", "newLine": true },
                "areas": {
                    "type": "table",
                    "label": "areas",
                    "newLine": true,
                    "useCardFor": ["xs", "sm", "md"],
                    "titleAttribute": "name",
                    "items": [
                        { "type": "text", "attr": "id", "title": "id", "width": "10%" },
                        { "type": "text", "attr": "name", "title": "areaName", "width": "16%" },
                        { "type": "select", "attr": "scheduleMode", "title": "scheduleMode", "width": "20%", "default": "weekdayWeekend", "options": [{ "label": "scheduleModeUniform", "value": "uniform" }, { "label": "scheduleModeWeekdayWeekend", "value": "weekdayWeekend" }, { "label": "scheduleModePerWeekday", "value": "perWeekday" }] },
                        { "type": "text", "attr": "weekday.open", "title": "weekdayOpen", "width": "13%", "hidden": "data.scheduleMode === 'perWeekday'" },
                        { "type": "text", "attr": "weekday.close", "title": "weekdayClose", "width": "13%", "hidden": "data.scheduleMode === 'perWeekday'" },
                        { "type": "text", "attr": "weekend.open", "title": "weekendOpen", "width": "13%", "hidden": "data.scheduleMode !== 'weekdayWeekend'" },
                        { "type": "text", "attr": "weekend.close", "title": "weekendClose", "width": "13%", "hidden": "data.scheduleMode !== 'weekdayWeekend'" },
                        { "type": "text", "attr": "holiday.open", "title": "holidayOpen", "width": "13%", "hidden": "data.scheduleMode === 'uniform'" },
                        { "type": "text", "attr": "holiday.close", "title": "holidayClose", "width": "13%", "hidden": "data.scheduleMode === 'uniform'" },
                        { "type": "text", "attr": "days.monday.open", "title": "weekdayMondayOpen", "hidden": "data.scheduleMode !== 'perWeekday'" }, { "type": "text", "attr": "days.monday.close", "title": "weekdayMondayClose", "hidden": "data.scheduleMode !== 'perWeekday'" },
                        { "type": "text", "attr": "days.tuesday.open", "title": "weekdayTuesdayOpen", "hidden": "data.scheduleMode !== 'perWeekday'" }, { "type": "text", "attr": "days.tuesday.close", "title": "weekdayTuesdayClose", "hidden": "data.scheduleMode !== 'perWeekday'" },
                        { "type": "text", "attr": "days.wednesday.open", "title": "weekdayWednesdayOpen", "hidden": "data.scheduleMode !== 'perWeekday'" }, { "type": "text", "attr": "days.wednesday.close", "title": "weekdayWednesdayClose", "hidden": "data.scheduleMode !== 'perWeekday'" },
                        { "type": "text", "attr": "days.thursday.open", "title": "weekdayThursdayOpen", "hidden": "data.scheduleMode !== 'perWeekday'" }, { "type": "text", "attr": "days.thursday.close", "title": "weekdayThursdayClose", "hidden": "data.scheduleMode !== 'perWeekday'" },
                        { "type": "text", "attr": "days.friday.open", "title": "weekdayFridayOpen", "hidden": "data.scheduleMode !== 'perWeekday'" }, { "type": "text", "attr": "days.friday.close", "title": "weekdayFridayClose", "hidden": "data.scheduleMode !== 'perWeekday'" },
                        { "type": "text", "attr": "days.saturday.open", "title": "weekdaySaturdayOpen", "hidden": "data.scheduleMode !== 'perWeekday'" }, { "type": "text", "attr": "days.saturday.close", "title": "weekdaySaturdayClose", "hidden": "data.scheduleMode !== 'perWeekday'" },
                        { "type": "text", "attr": "days.sunday.open", "title": "weekdaySundayOpen", "hidden": "data.scheduleMode !== 'perWeekday'" }, { "type": "text", "attr": "days.sunday.close", "title": "weekdaySundayClose", "hidden": "data.scheduleMode !== 'perWeekday'" }
                    ]
                },
                "icalHint": { "type": "staticText", "text": "icalHintText", "newLine": true },
                "icalAdapterInstance": { "type": "text", "label": "icalAdapterInstance", "newLine": true },
                "icalTitlePrefix": { "type": "text", "label": "icalTitlePrefix" }
            }
        },
        "_weather": {
            "type": "panel",
            "label": "weather",
            "items": {
                "weatherHint": { "type": "staticText", "text": "weatherHintText", "newLine": true },
                "weather.solarRadiationStateId": { "type": "objectId", "label": "weatherSolarRadiation", "newLine": true },
                "weather.windSpeedStateId": { "type": "objectId", "label": "weatherWindSpeed" },
                "weather.rainStateId": { "type": "objectId", "label": "weatherRain", "filter": { "type": "state", "common": { "type": "boolean" } } },
                "weather.outdoorTempStateId": { "type": "objectId", "label": "weatherOutdoorTemp" },
                "weather.humidityStateId": { "type": "objectId", "label": "weatherHumidity" },
                "weather.isSummerStateId": { "type": "objectId", "label": "weatherIsSummer", "filter": { "type": "state", "common": { "type": "boolean" } } },
                "weather.cloudCoverStateId": { "type": "objectId", "label": "weatherCloudCover" },
                "weather.windDirectionStateId": { "type": "objectId", "label": "weatherWindDirection" },
                "weather.heatingPeriodStart": { "type": "text", "label": "heatingPeriodStart" },
                "weather.heatingPeriodEnd": { "type": "text", "label": "heatingPeriodEnd" }
            }
        },
        "_automation": {
            "type": "panel",
            "label": "thresholds",
            "items": {
                "thresholdsHint": { "type": "staticText", "text": "thresholdsHintText", "newLine": true },
                "sunProtectionGlobalEnabled": { "type": "checkbox", "label": "sunProtectionGlobalEnabled", "default": true, "newLine": true },
                "sunCloseThreshold": { "type": "number", "label": "sunCloseThreshold", "min": 0 },
                "sunOpenThreshold": { "type": "number", "label": "sunOpenThreshold", "min": 0 },
                "sunOpenMinDurationMs": { "type": "number", "label": "sunOpenMinDurationMs", "min": 0 },
                "sunProtectionCloudCoverTriggerEnabled": { "type": "checkbox", "label": "sunProtectionCloudCoverTriggerEnabled" },
                "sunProtectionClearSkyCloudCoverMaxPercent": { "type": "number", "label": "sunProtectionClearSkyCloudCoverMaxPercent", "min": 0, "max": 100, "hidden": "!data.sunProtectionCloudCoverTriggerEnabled" },
                "windOpenThreshold": { "type": "number", "label": "windOpenThreshold", "min": 0, "newLine": true },
                "windCloseAllowedThreshold": { "type": "number", "label": "windCloseAllowedThreshold", "min": 0 },
                "windCalmMinDurationMs": { "type": "number", "label": "windCalmMinDurationMs", "min": 0 },
                "frostThreshold": { "type": "number", "label": "frostThreshold" },
                "nightCoolingIndoorMinTemp": { "type": "number", "label": "nightCoolingIndoorMinTemp", "newLine": true },
                "nightCoolingMinDelta": { "type": "number", "label": "nightCoolingMinDelta", "min": 0 },
                "automationTickMs": { "type": "number", "label": "automationTickMs", "min": 1000 }
            }
        },
        "_groups": {
            "type": "panel",
            "label": "groups",
            "items": {
                "groupsHint": { "type": "staticText", "text": "groupsHintText", "newLine": true },
                "groups": { "type": "table", "label": "groups", "newLine": true, "useCardFor": ["xs", "sm", "md"], "titleAttribute": "name", "items": [{ "type": "text", "attr": "id", "title": "id" }, { "type": "text", "attr": "name", "title": "name" }, { "type": "select", "attr": "memberIds", "title": "groupMemberIds", "multiple": true, "options": "(data.shutters || []).map(shutter => ({ value: shutter.id, label: shutter.name || shutter.id }))" }] }
            }
        },
        "_scenes": {
            "type": "panel",
            "label": "scenes",
            "items": {
                "scenesHint": { "type": "staticText", "text": "scenesHintText", "newLine": true },
                "scenes": { "type": "table", "label": "scenes", "newLine": true, "useCardFor": ["xs", "sm", "md"], "titleAttribute": "name", "items": [{ "type": "text", "attr": "id", "title": "id" }, { "type": "text", "attr": "name", "title": "name" }, { "type": "table", "attr": "targets", "title": "sceneTargets", "items": [{ "type": "select", "attr": "coveringId", "title": "sceneTargetCovering", "options": "(globalData.shutters || []).map(shutter => ({ value: shutter.id, label: shutter.name || shutter.id }))" }, { "type": "number", "attr": "percent", "title": "sceneTargetPosition", "min": 0, "max": 100 }] }] }
            }
        },
        "_notifications": {
            "type": "panel",
            "label": "notifications",
            "items": {
                "notifyHint": { "type": "staticText", "text": "notifyHintText", "newLine": true },
                "pushoverInstance": { "type": "text", "label": "pushoverInstance", "newLine": true },
                "telegramInstance": { "type": "text", "label": "telegramInstance" }
            }
        }
    }
}
